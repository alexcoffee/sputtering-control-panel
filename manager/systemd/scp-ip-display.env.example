# Override these if your Pi Zero display wiring differs from the defaults in the service unit.
# The code uses SPI0 /dev/spidev0.0 and a plain ST7789 command/data/reset path.

# SCP_DISPLAY_SPI_DEVICE=/dev/spidev0.0
# SCP_DISPLAY_DC_GPIO=25
# SCP_DISPLAY_RESET_GPIO=24
# SCP_DISPLAY_BACKLIGHT_GPIO=23
# SCP_DISPLAY_X_OFFSET=52
# SCP_DISPLAY_Y_OFFSET=40
# SCP_DISPLAY_WIDTH=135
# SCP_DISPLAY_HEIGHT=240
# SCP_DISPLAY_ROTATION=0
# SCP_DISPLAY_X_OFFSET=0
# SCP_DISPLAY_Y_OFFSET=0
# SCP_DISPLAY_POLL_INTERVAL_SEC=2.0
