[Unit]
Description=SCP Manager Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/sputtering-control-panel
ExecStart=/usr/bin/python3 -m manager.scp_manager.app --host 0.0.0.0 --port 8080 --can-interface can0
Restart=on-failure
RestartSec=2
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
